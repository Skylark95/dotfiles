# Enable aliases to be sudo’ed
#   http://askubuntu.com/questions/22037/aliases-not-available-when-using-sudo
alias sudo='sudo '

# Clear
alias clr='clear'
alias cls='clear'

# Go to the /home/$USER (~) directory and clears window of your terminal
alias q="~ && clear"

# Folders Shortcuts
[ -d ~/Downloads ] && alias dl='cd ~/Downloads'
[ -d ~/Desktop ]   && alias dt='cd ~/Desktop'
[ -d ~/git ]       && alias pj='cd ~/git'

# Commands Shortcuts
alias e="$EDITOR"
alias vi="nvim"

# pbcopy / pbpaste on linux
if command -v xclip &> /dev/null; then
  alias pbcopy='xclip -selection clipboard'
  alias pbpaste='xclip -selection clipboard -o'
fi

# Quick jump to dotfiles
alias dotfiles="cd $DOTFILES"

# Quick edit of dotfiles
alias vimzshrc="$EDITOR $DOTFILES/zshrc"
alias vimalias="$EDITOR $DOTFILES/alias"
alias vimec="$EDITOR $DOTFILES/editorconfig"
alias vimenv="$EDITOR $DOTFILES/env"
alias vimfunctions="$EDITOR $DOTFILES/functions"

# Quick reload of zsh environment
alias reload="source $HOME/.zshrc"
alias src="source $HOME/.zshrc"

# Show $PATH in readable view
alias path='echo -e ${PATH//:/\\n}'

# AWS
alias vimawscreds="$EDITOR $HOME/.aws/credentials"
alias vimawsconfig="$EDITOR $HOME/.aws/config"

# fzf
alias fzfp="fzf --preview 'bat --color=always {}' --preview-window '~3'"

# Git
alias gcdt="git difftool"
alias gop="git open"
alias gclg='git log --pretty='%s' $HEAD...$(git_main_branch)'
alias gsur='git submodule update --recursive'
alias gsuir='git submodule update --init --recursive'
alias gsy='git submodule sync'
alias gsyr='git submodule sync --recursive'

# Json
alias json='curl -H "Content-Type: application/json"'
alias jsonapi='curl -H "Content-Type: application/vnd.api+json"'

# Maven
alias mvndoc='mvn -B clean javadoc:javadoc -Ddoclint=none'
alias mvnv='mvn help:evaluate -Dexpression=project.version'
alias mvnvq='mvn help:evaluate -Dexpression=project.version -q -DforceStdout'

# Python
alias pip='pip3'

# OpenTofu
alias tfwd="tofu workspace delete"
alias tfwl="tofu workspace list"
alias tfwn="tofu workspace new"
alias tfws="tofu workspace select"
alias tfiu="tofu init -upgrade"
